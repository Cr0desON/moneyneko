# ПЛАГИНЫ И ТЕМЫ (Белый список)

#Запрещаем Git отслеживать все плагины и темы
wp-content/plugins/*
wp-content/themes/*
wp-content/mu-plugins/*

#РАЗРЕШАЕМ отслеживать плагин и текущую тему
!wp-content/plugins/moneyneko-trainers-hub/
!wp-content/themes/astra/

# ПЕРЕВОДЫ

# Игнорируем автозагружаемые переводы ядра WP и сторонних плагинов —
# они подтягиваются автоматически с translate.wordpress.org
wp-content/languages/*

# НО оставляем папку Loco — там наши собственные переводы плагинов без RU-локали
!wp-content/languages/loco/

# Внутри Loco трекаем .po/.mo/.l10n.php, но игнорируем автогенерируемые
# бэкап-снэпшоты (файлы с хэшем в имени)
wp-content/languages/loco/**/*.json
